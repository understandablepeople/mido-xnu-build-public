diff --git a/bsd/dev/mido_mmc.c b/bsd/dev/mido_mmc.c
index 496e3f7..c9eb02e 100644
--- a/bsd/dev/mido_mmc.c
+++ b/bsd/dev/mido_mmc.c
@@ -33,6 +33,12 @@
 #include <pexpert/pexpert.h>
 #include <pexpert/device_tree.h>
 #include <libkern/libkern.h>
+#include <machine/atomic.h>
+
+extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
+extern void thread_deallocate(thread_t);
+extern int hz;
+static void mido_log_start(void);
 
 /* osfmk/arm/machine_routines.h, not exported to the BSD layer */
 extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
@@ -738,11 +744,112 @@ mido_mmc_init(void)
 	devfs_make_node(mm.bdev, DEVFS_BLOCK, UID_ROOT, GID_OPERATOR, 0640, "mmcroot0");
 	devfs_make_node(makedev(mm.cmajor, 0), DEVFS_CHAR, UID_ROOT, GID_OPERATOR, 0640, "rmmcroot0");
 	mm.ready = true;
+	mido_log_start();
 	printf("MIDO MMC: \"%s\": first sector 0x%llx, %llu MiB, %s\n", want, mm.first,
 	    mm.nsect >> 11, mm.writable ? "READ-WRITE (confined to the partition)" : "read-only");
 	return 0;
 }
 
+/*
+ * Persistent console log ("midolog"). The phone has no serial port and filming the screen
+ * loses everything the panic overwrites, so every character that reaches the console
+ * (kernel printf and /dev/console writes of daemons, both through _cnputs) is also kept in
+ * a 4 MiB ring. Once the partition is known and writable (boot-arg mmcrw=1) a thread copies
+ * new ring data to the LAST 4 MiB + 512 B of the partition about once a second (far behind
+ * the HFS image at its start). Sector 0 of that area is a header:
+ *   "MIDOLOG" NUL | u32 version 1 | u32 ring size | u64 total bytes written | u64 flush seq
+ * The ring offset of byte n is n % ring size. Read it back from TWRP with
+ * tools/mido-log-pull.sh. Disable with boot-arg midolog=0.
+ */
+#define MIDO_LOG_SIZE          (4u << 20)
+#define MIDO_LOG_SECTORS       (1 + MIDO_LOG_SIZE / SECSIZE)
+
+static char mido_log_ring[MIDO_LOG_SIZE];
+static uint64_t _Atomic mido_log_total;
+static int mido_log_chan;
+
+/* Called for all console output, any context: never blocks. */
+void mido_log_append(const char *c, int size);
+
+void
+mido_log_append(const char *c, int size)
+{
+	if (size <= 0) {
+		return;
+	}
+	uint64_t at = os_atomic_add_orig(&mido_log_total, (uint64_t)size, relaxed);
+	for (int i = 0; i < size; i++) {
+		mido_log_ring[(at + (uint64_t)i) % MIDO_LOG_SIZE] = c[i];
+	}
+}
+
+struct mido_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq;
+};
+
+static void
+mido_log_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t base = mm.first + mm.nsect - MIDO_LOG_SECTORS;     /* header sector */
+	uint64_t flushed = 0, seq = 0;
+	static uint8_t hdr[SECSIZE];
+
+	printf("MIDO LOG: console log to the last %u KiB of the partition (sector 0x%llx)\n",
+	    MIDO_LOG_SECTORS * SECSIZE >> 10, base);
+	for (;;) {
+		(void)tsleep(&mido_log_chan, PZERO, "midolog", hz);
+		uint64_t total = os_atomic_load(&mido_log_total, relaxed);
+		if (total == flushed) {
+			continue;
+		}
+		uint64_t pos = total - flushed >= MIDO_LOG_SIZE ? total - MIDO_LOG_SIZE : flushed;
+		int error = 0;
+
+		lck_mtx_lock(&mido_mmc_lock);
+		while (pos < total && !error) {
+			uint32_t off = (uint32_t)(pos % MIDO_LOG_SIZE);
+			uint32_t sec = off / SECSIZE;
+			uint64_t need = ((uint64_t)off % SECSIZE + (total - pos) + SECSIZE - 1) / SECSIZE;
+			uint32_t n = (uint32_t)MIN(MIN(need, (uint64_t)(MIDO_LOG_SIZE / SECSIZE - sec)),
+			    (uint64_t)MAX_BLOCKS_CMD);
+			error = mmc_write_sectors(base + 1 + sec, n, (const uint8_t *)mido_log_ring + (uint64_t)sec * SECSIZE);
+			pos += (uint64_t)(sec + n) * SECSIZE - off;
+		}
+		if (!error) {
+			struct mido_log_header h = {
+				.magic = { 'M', 'I', 'D', 'O', 'L', 'O', 'G', 0 },
+				.version = 1, .size = MIDO_LOG_SIZE, .total = total, .seq = ++seq,
+			};
+			bzero(hdr, SECSIZE);
+			memcpy(hdr, &h, sizeof(h));
+			error = mmc_write_sectors(base, 1, hdr);
+		}
+		lck_mtx_unlock(&mido_mmc_lock);
+		if (error) {
+			printf("MIDO LOG: write failed (%d), stopping\n", error);
+			return;
+		}
+		flushed = total;
+	}
+}
+
+static void
+mido_log_start(void)
+{
+	uint32_t on = 1;
+	thread_t thread;
+
+	PE_parse_boot_argn("midolog", &on, sizeof(on));
+	if (!on || !mm.writable || mm.nsect < 2 * MIDO_LOG_SECTORS) {
+		return;
+	}
+	if (kernel_thread_start(mido_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
 /* Root device for rd=mmcroot0 (IOFindBSDRoot). */
 int mido_mmc_rootdev(dev_t *dev);
 
diff --git a/osfmk/console/serial_console.c b/osfmk/console/serial_console.c
index e5b23f2..e684d3a 100644
--- a/osfmk/console/serial_console.c
+++ b/osfmk/console/serial_console.c
@@ -266,11 +266,19 @@ _cnputc(char c, bool poll)
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(ARM64_BOARD_CONFIG_MIDO)
+extern void mido_log_append(const char *c, int size);  /* bsd/dev/mido_mmc.c */
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	extern int disableConsoleOutput;
 
+#if defined(ARM64_BOARD_CONFIG_MIDO)
+	mido_log_append(c, size);
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
