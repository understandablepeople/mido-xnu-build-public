@@ -266,11 +266,19 @@ _cnputc(char c, bool poll)
  *             waiting for an interrupt when the hardware device isn't ready
  * @param size The number of characters to print to the console.
  */
+#if defined(ARM64_BOARD_CONFIG_MIDO)
+extern void mido_log_append(const char *c, int size);  /* bsd/dev/mido_mmc.c */
+#endif
+
 static inline void
 _cnputs(char *c, int size, bool poll)
 {
 	extern int disableConsoleOutput;
 
+#if defined(ARM64_BOARD_CONFIG_MIDO)
+	mido_log_append(c, size);
+#endif
+
 	if (disableConsoleOutput) {
 		return;
 	}
