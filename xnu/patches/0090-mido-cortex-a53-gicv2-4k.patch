+#if defined(MIDO)
+/*
+ * GICv2 CPU interface: IAR/EOIR are MMIO registers (the GICv3 system
+ * registers do not exist on the Cortex-A53). GICC is banked per CPU and
+ * sits at the same address on every core.
+ */
+static inline uint32_t
+mido_gic_ack(void)
+{
+	return *(volatile uint32_t *)(mido_gicc_base + GICC_IAR);
+}
+
+static inline void
+mido_gic_eoi(uint32_t iar)
+{
+	*(volatile uint32_t *)(mido_gicc_base + GICC_EOIR) = iar;
+}
+#endif /* MIDO */
