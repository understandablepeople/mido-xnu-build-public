diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index b77ff88..82e7aab 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -222,6 +222,104 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* MIDO */
 }
+#elif HAS_GIC_V2
+
+/* Phone default; the device tree may override it (virtual-timer-intid). */
+SECURITY_READ_ONLY_LATE(uint32_t) mido_vtimer_intid = MIDO_VTIMER_INTID;
+
+vm_offset_t mido_gicd_base;
+vm_offset_t mido_gicc_base;
+
+#define gicd_read32(offset) (*((volatile uint32_t *)(mido_gicd_base + (offset))))
+#define gicd_write32(offset, data) (*((volatile uint32_t *)(mido_gicd_base + (offset))) = (data))
+#define gicc_write32(offset, data) (*((volatile uint32_t *)(mido_gicc_base + (offset))) = (data))
+
+void
+pe_init_fiq()
+{
+	int error;
+	DTEntry entry;
+
+	/*
+	 * mido_gicd_base is 0 only before the boot processor maps the GIC.
+	 * Avoid SecureDT* on secondary processors (not thread-safe).
+	 */
+	if (!mido_gicd_base) {
+		error = SecureDTLookupEntry(NULL, "/arm-io/gic", &entry);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC node in DT", __func__);
+		}
+
+		void const *prop;
+		unsigned int prop_size;
+		error = SecureDTGetProperty(entry, "reg", &prop, &prop_size);
+		if (error != kSuccess) {
+			panic("%s: cannot find GIC MMIO regions in DT", __func__);
+		}
+
+		/* GICD base, GICD size, GICC base, GICC size */
+		if (prop_size < 4 * sizeof(uint64_t)) {
+			panic("%s: incorrect reg property size in GIC DT node; expecting 32 bytes but got %u bytes", __func__, prop_size);
+		}
+
+		/* Read only on the boot CPU, before the GIC and RO-late lockdown. */
+		void const *timer_prop;
+		unsigned int timer_size;
+		if (SecureDTGetProperty(entry, "virtual-timer-intid", &timer_prop, &timer_size) == kSuccess) {
+			if (timer_size != sizeof(uint32_t)) {
+				panic("%s: invalid virtual-timer-intid size %u", __func__, timer_size);
+			}
+			uint32_t intid = *(const uint32_t *)timer_prop;
+			if (intid < 16 || intid >= 32) {
+				panic("%s: virtual timer INTID %u is not a PPI", __func__, intid);
+			}
+			mido_vtimer_intid = intid;
+		}
+		kprintf("MIDO GIC: v2 virtual timer INTID %u\n", mido_vtimer_intid);
+
+		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
+
+		uint64_t const gicd_base_prop = ((uint64_t const *) prop)[0];
+		uint64_t const gicd_size_prop = ((uint64_t const *) prop)[1];
+		uint64_t const gicc_base_prop = ((uint64_t const *) prop)[2];
+		uint64_t const gicc_size_prop = ((uint64_t const *) prop)[3];
+
+		vm_offset_t gicc = ml_io_map(soc_base_phys + gicc_base_prop, gicc_size_prop);
+		if (!gicc) {
+			panic("%s: cannot map GICC region", __func__);
+		}
+		mido_gicc_base = gicc;
+
+		/* Publish gicd last: it is the "initialized" flag for other CPUs. */
+		vm_offset_t gicd = ml_io_map(soc_base_phys + gicd_base_prop, gicd_size_prop);
+		if (!gicd) {
+			panic("%s: cannot map GICD region", __func__);
+		}
+		__builtin_arm_dmb(DMB_ISH);
+		mido_gicd_base = gicd;
+	}
+
+	/*
+	 * Per-CPU banked state: Group 1 (non-secure) interrupts only. The
+	 * non-secure view of IGROUPR may read as zero; delivery still works
+	 * because TrustZone configured the PPIs/SGIs as non-secure.
+	 */
+	gicd_write32(GICD_IGROUPR0, 0xFFFFFFFF);
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR0 + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER0, (1U << mido_vtimer_intid) | (1U << MIDO_IPI_SGI));
+
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	/* Enable Group 1 forwarding; EOImode = 0 so EOIR also deactivates. */
+	gicc_write32(GICC_CTLR, GICC_CTLR_ENABLEGRP1);
+
+	/* The distributor was left enabled by lk2nd; make sure of it. */
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	__builtin_arm_dsb(DSB_SY);
+	__builtin_arm_isb(ISB_SY);
+}
 #else
 void
 pe_init_fiq()
