+/*
+ * Synchronous flush for callers about to touch hardware that may reset the phone (TrustZone-owned
+ * registers): the last "about to read" line then survives on the partition. 1 = written, 0 = log not
+ * ready (no writable userdata yet). Never call from interrupt context.
+ */
+int mido_log_sync(uint32_t note);
+
+int
+mido_log_sync(uint32_t note)
+{
+	if (!mm.ready || !mm.writable || !mido_log_on) {
+		return 0;
+	}
+	lck_mtx_lock(&mido_mmc_lock);
+	int error = mido_log_flush(note);
+	lck_mtx_unlock(&mido_mmc_lock);
+	return error == 0;
+}
