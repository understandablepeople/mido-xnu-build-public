+MidoSurface *
+mido_surface_create_buffer(uint32_t width, uint32_t height, uint32_t pixelFormat)
+{
+	if (width == 0 || height == 0 || width > 16384 || height > 16384) {
+		return NULL;
+	}
+	MidoSurface *surface = mido_surface_alloc();
+	if (surface == NULL) {
+		return NULL;
+	}
+	surface->width = width;
+	surface->height = height;
+	surface->bytesPerRow = (width * 4 + 63) & ~63U;
+	surface->bytesPerElement = 4;
+	surface->elementWidth = surface->elementHeight = 1;
+	surface->pixelFormat = pixelFormat;
+	surface->allocSize = (uint32_t)round_page((uint64_t)surface->bytesPerRow * height);
+	uint64_t previous = (uint64_t)OSAddAtomic64(surface->allocSize,
+	    (volatile SInt64 *)&mido_surface_wired);
+	if (previous + surface->allocSize <= MIDO_SURFACE_WIRED_MAX) {
+		surface->memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIODirectionInOut | kIOMemoryKernelUserShared, surface->allocSize, page_size);
+	}
+	if (surface->memory == NULL) {
+		OSAddAtomic64(-(SInt64)surface->allocSize, (volatile SInt64 *)&mido_surface_wired);
+		surface->release();
+		return NULL;
+	}
+	surface->mapCache = kIOMapDefaultCache;
+	bzero((void *)surface->kernelAddress(), surface->allocSize);
+	if (!mido_surface_publish(surface)) {
+		surface->release();
+		return NULL;
+	}
+	return surface;
+}
+
+void
+mido_surface_release_kernel(MidoSurface *surface)
+{
+	if (surface != NULL) {
+		mido_surface_put(surface);
+		surface->release();
+	}
 }
 
