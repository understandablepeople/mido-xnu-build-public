+	mido_early_map_final();
+#endif
 	arm_vm_physmap_init(args);
 	set_mmu_ttb_alternate(cpu_ttep & TTBR_BADDR_MASK);
 
 	ml_enable_monitor();
 
-	/* The framebuffer VA=PA mapping belongs to the outgoing TTBR0. */
-	mido_early_disable();
+#if defined(MIDO)
+	/* The final TTBR1 is live; leave the outgoing VA=PA framebuffer alias. */
+	mido_early_relocate(MIDO_EARLY_FB_VA);
+#endif
 	set_mmu_ttb(invalid_ttep & TTBR_BADDR_MASK);
 
 	flush_mmu_tlb();
+	mido_early_mark(10, "TTBR0 off; TLB flushed");
 	kva_active = TRUE;
 	// global table pointers may need to be different due to physical aperture remapping
 	cpu_tte = (tt_entry_t*)(phystokv(cpu_ttep));
 	invalid_tte = (tt_entry_t*)(phystokv(invalid_ttep));
+	mido_early_mark(11, "physmap table pointers rebound");
 
 	// From here on out, we're off the bootstrap translation tables.
 
@@ -2259,7 +2316,9 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
     }
 #endif
 #endif
+	mido_early_mark(12, "calling pmap_bootstrap");
 	pmap_bootstrap(dynamic_memory_begin);
+	mido_early_mark(13, "pmap_bootstrap done");
 
 	disable_preemption();
 
@@ -2310,6 +2369,7 @@ arm_vm_init(uint64_t memory_size, boot_args * args)
 		va_l1 = va_l2_end;
 		cpu_l1_tte++;
 	}
+	mido_early_mark(14, "early I/O page tables ready");
 
 #if defined(KERNEL_INTEGRITY_KTRR) || defined(KERNEL_INTEGRITY_CTRR)
 	/*
