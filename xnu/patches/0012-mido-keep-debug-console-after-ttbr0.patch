index 55e45de..933c2f0 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -42,6 +42,7 @@
 #include <arm64/proc_reg.h>
 #include <arm64/lowglobals.h>
 #include <arm64/mido_early.h>
+#include <arm64/mido_fb.h>
 #include <arm/cpu_data_internal.h>
 #include <arm/misc_protos.h>
 #include <pexpert/arm64/boot.h>
@@ -1825,6 +1826,54 @@ init_ptpages(tt_entry_t *tt, vm_map_address_t start, vm_map_address_t end, bool
 #define ARM64_PHYSMAP_ALIGNMENT_PADDING (PTOV_TABLE_SIZE * ARM_TT_TWIG_SIZE)
 #endif
 
+#if defined(MIDO)
+/*
+ * The reserved low-globals/kernel region is excluded from VM allocation.
+ * Use the otherwise empty VA between low globals (first 2MiB at
+ * VM_MIN_KERNEL_ADDRESS) and gVirtBase for a Normal-NC framebuffer alias that
+ * survives bootstrap TTBR0 teardown. 4K granule: the splash (phys 0x90001000,
+ * 0x5EEC00 bytes) spans MIDO_FB_BLOCKS (3) consecutive 2MiB L2 blocks, so the
+ * alias is MIDO_FB_BLOCKS contiguous L2 slots starting one block above low
+ * globals. Pixel 0 is at MIDO_EARLY_FB_VA + MIDO_FB_BLOCK_OFFSET.
+ */
+#define MIDO_EARLY_FB_VA (VM_MIN_KERNEL_ADDRESS + ARM_TT_L2_SIZE)
+
+static void
+mido_early_map_final(void)
+{
+	const vm_map_address_t va = MIDO_EARLY_FB_VA;
+	_Static_assert(ARM_TT_L2_SIZE == MIDO_FB_BLOCK_SIZE, "4K granule: L2 block must be 2MiB");
+	_Static_assert(BOOTSTRAP_TABLE_SIZE == MIDO_BOOTSTRAP_PAGES * ARM_PGBYTES, "start.s bootstrap page budget");
+	if (va + MIDO_FB_BLOCKS * ARM_TT_L2_SIZE > gVirtBase) {
+		/* Kernel image would overlap the alias (ARM_LARGE_MEMORY needs a link address >= VM_MIN + 8MiB). */
+		panic("mido: early fb alias [%p, +%#x) overlaps kernel at %p", (void *)va,
+		    (unsigned int)(MIDO_FB_BLOCKS * ARM_TT_L2_SIZE), (void *)gVirtBase);
+	}
+	/* All slots must sit in the single L2 table covered by one L1 entry. */
+	assert(((va + MIDO_FB_BLOCKS * ARM_TT_L2_SIZE - 1) & ARM_TT_L1_INDEX_MASK) == (va & ARM_TT_L1_INDEX_MASK));
+	tt_entry_t *l1p = &cpu_tte[(va & ARM_TT_L1_INDEX_MASK) >> ARM_TT_L1_SHIFT];
+	if (*l1p == ARM_TTE_EMPTY) {
+		/* Nothing covered this L1 slot yet (same recipe as the low globals table). */
+		vm_offset_t ptpage_vaddr = alloc_ptpage(TRUE);
+		bzero((void *)ptpage_vaddr, ARM_PGBYTES);
+		*l1p = (kvtophys(ptpage_vaddr) & ARM_TTE_TABLE_MASK) | ARM_TTE_TYPE_TABLE | ARM_TTE_VALID |
+		    ARM_TTE_TABLE_PXN | ARM_TTE_TABLE_XN;
+	}
+	tt_entry_t l1 = *l1p;
+	assert((l1 & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_TABLE));
+	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
+	for (unsigned int i = 0; i < MIDO_FB_BLOCKS; i++) {
+		tt_entry_t *slot = &l2[((va + i * ARM_TT_L2_SIZE) & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
+		assert(*slot == ARM_TTE_EMPTY);
+		*slot = (uint64_t)(MIDO_FB_BLOCK_PA + i * ARM_TT_L2_SIZE) | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+		    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
+		    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
+		    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
+	}
+	__asm__ volatile("dsb ishst" ::: "memory");
+}
+#endif
