diff --git a/osfmk/arm64/mido_fb.h b/osfmk/arm64/mido_fb.h
new file mode 100644
index 0000000..acb1407
--- /dev/null
+++ b/osfmk/arm64/mido_fb.h
@@ -0,0 +1,42 @@
+/*
+ * mido (Redmi Note 4X, MSM8953) boot framebuffer: the lk2nd continuous
+ * splash. The single definition of its geometry. Usable from C and from
+ * assembly (#defines only). 4 KiB granule only: an L2 block is 2 MiB.
+ *
+ * boot_args.Video carries the same values at run time (v_baseAddr 0x90001000,
+ * v_rowBytes 3240, v_width 1080, v_height 1920, depth 24); C code should
+ * prefer PE_state.video. These constants are for start.s, which runs before
+ * anything is parsed, and for the early debug console.
+ */
+#ifndef _ARM64_MIDO_FB_H_
+#define _ARM64_MIDO_FB_H_
+
+#define MIDO_FB_PHYS            0x90001000      /* first pixel; NOT 2 MiB aligned */
+#define MIDO_FB_WIDTH           1080
+#define MIDO_FB_HEIGHT          1920
+#define MIDO_FB_BPP             3               /* bytes per pixel, memory order B,G,R */
+#define MIDO_FB_STRIDE          3240            /* bytes per line == WIDTH * BPP */
+#define MIDO_FB_SIZE            0x5EEC00        /* STRIDE * HEIGHT */
+
+/* L2 blocks (2 MiB each, 4K granule) needed to map the whole buffer. */
+#define MIDO_FB_BLOCK_SIZE      0x200000
+#define MIDO_FB_BLOCK_PA        0x90000000      /* MIDO_FB_PHYS rounded down to a block */
+#define MIDO_FB_BLOCK_OFFSET    0x1000          /* MIDO_FB_PHYS - MIDO_FB_BLOCK_PA */
+#define MIDO_FB_BLOCKS          3               /* 0x90000000..0x90600000 */
+
+/*
+ * Bootstrap page-table pages (osfmk/arm/pmap/pmap.h BOOTSTRAP_TABLE_SIZE is
+ * ARM_PGBYTES * this; pmap.h is not assembler-visible). 8 stock pages plus
+ * the L2 table for the framebuffer's L1 slot.
+ */
+#define MIDO_BOOTSTRAP_PAGES    34
+
+/* Text colours, byte values in memory order. White on dark blue. */
+#define MIDO_FB_FG_B            0xff
+#define MIDO_FB_FG_G            0xff
+#define MIDO_FB_FG_R            0xff
+#define MIDO_FB_BG_B            0x40
+#define MIDO_FB_BG_G            0x18
+#define MIDO_FB_BG_R            0x08
+
+#endif /* _ARM64_MIDO_FB_H_ */
