+	}
+	for (int t = 0; t < 3; t++) {
+		if (!(e = mmc_cmd(3, 1u << 16, 0x1a, 0, resp))) {
+			break;
+		}
+		delay(10000);
+	}
+	if (e) {
+		return e;
+	}
+	mido_mmc_dbg[0] = 40;
+	if ((e = mmc_cmd(7, 1u << 16, 0x1b, 0, resp))) {
 		return e;
 	}
 
@@ -478,6 +496,30 @@ mmc_init_card(void)
 	return mmc_wait_ready();
 }
 
+/* Whole initialisation from reset, repeated a few times: the card state left by TWRP/lk2nd varies. */
+static int
+mmc_init_card(void)
+{
+	int e = EIO;
+
+	for (int attempt = 1; attempt <= 5; attempt++) {
+		mido_mmc_dbg[3] = (uint32_t)attempt;
+		e = mmc_init_card_once();
+		if (!e) {
+			if (attempt > 1) {
+				printf("MIDO MMC: card initialised on attempt %d\n", attempt);
+			}
+			return 0;
+		}
+		printf("MIDO MMC: init attempt %d failed: %d (step %u cmd %u st 0x%x)\n", attempt, e,
+		    mido_mmc_dbg[0], mido_mmc_dbg[1], mido_mmc_dbg[2]);
+		mmc_cmd_reset();
+		sd_wr8(SD_PWR, 0);                  /* drop bus power for a clean restart */
+		delay(50000);
+	}
+	return e;
+}
