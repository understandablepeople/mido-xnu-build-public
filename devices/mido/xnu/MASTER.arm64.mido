# DEVELOPMENT = [ MIDO_BASE development mach_assert ]
# DEBUG = [ MIDO_BASE debug mach_assert ]

machine "arm64" # <arm64>
makeoptions OSFMK_MACHINE = "arm64" # <mach>
options CONFIG_VNODES=1024 # <xsmall>
options CONFIG_MACH_APPROXIMATE_TIME
pseudo-device mido_no_amcc
pseudo-device mido_runtime
