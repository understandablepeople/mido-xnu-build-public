# MIDO_RUNTIME = [ mach_bsd psynch inet iokit iokitcpp libkerncpp config_blocks zlib crypto_sha2 ]
# MIDO_SCHED = [ config_sched_traditional config_sched_multiq config_sched_deferred_ast ]
# MIDO_FILESYSTEM = [ devfs fifo namedstreams config_fse ]
# MIDO_BSD_DEPENDENCIES = [ memorystatus jetsam config_macf vm_pressure_events config_coalitions importance_inheritance config_iosched ]
# MIDO_NETWORK_DEPENDENCIES = [ necp multipath mptcp traffic_mgt skywalk config_nexus_user_pipe config_nexus_kernel_pipe config_nexus_monitor config_nexus_flowswitch config_nexus_netif ipsec pf content_filter ]
# MIDO_LINK_DEPENDENCIES = [ crypto config_atm config_telemetry config_proc_uuid_policy config_coredump mach_kdp kdp_interactive_debugging config_dtrace iotracking config_xnupost ]
# MIDO_ARM_SOURCES = [ nos_arm_pmap nos_arm_asm config_pmap_ppl ]
