diff --git a/pexpert/pexpert/arm64/MIDO.h b/pexpert/pexpert/arm64/MIDO.h
new file mode 100644
--- /dev/null
+++ b/pexpert/pexpert/arm64/MIDO.h
@@ -0,0 +1,26 @@
+#ifndef _PEXPERT_ARM_MIDO_H
+#define _PEXPERT_ARM_MIDO_H
+
+#if !defined(__aarch64__) && !defined(__arm64__)
+#error MIDO requires AArch64
+#endif
+#if defined(__arm64e__) || defined(__ARM_FEATURE_PAUTH) || defined(__ARM_FEATURE_ATOMICS)
+#error MIDO scaffold requires baseline ARMv8-A without PAC or LSE
+#endif
+#ifdef __ARM_16K_PG__
+#error MIDO scaffold requires the 4KB page path
+#endif
+
+#define MIDO 1
+#define MIDO_BRINGUP 1
+#define NO_MONITOR 1
+#define NO_ECORE 1
+#define ARM_ARCH_TIMER 1
+#define __ARM_ARCH__ 8
+#define __ARM_VMSA__ 8
+#define __ARM_VFP__ 4
+#define __ARM_COHERENT_CACHE__ 1
+#define __ARM_DEBUG__ 7
+#define __ARM64_PMAP_SUBPAGE_L1__ 1
+
+#endif
